APP_NAME=GovPilot API
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://govpilot:govpilot_local@localhost:5432/govpilot
# Durable local LangGraph state. The generated file is excluded from Git.
CHECKPOINT_DATABASE_PATH=data/langgraph-checkpoints.sqlite3
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=govpilot
S3_SECRET_KEY=govpilot_local_secret
S3_BUCKET=govpilot-documents
S3_REGION=us-east-1

# Add the real value only to backend/.env. Never commit it.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
